# Origin the dashboard calls. Leave empty in local development: the Vite dev
# server proxies /api to the backend (see vite.config.ts), which keeps the app
# same-origin and avoids CORS configuration on the FastAPI side.
#
# PRODUCTION: set this to the origin serving the FastAPI service, e.g.
#   VITE_API_BASE_URL=https://api.civicai.example
VITE_API_BASE_URL=

# Optional path prefix placed before every backend route. Leave EMPTY unless the
# service is genuinely mounted behind a gateway that adds a prefix.
#
# The FastAPI service serves /auth/login, /complaints, /intelligence/... with no
# prefix, so in production this must stay empty unless your gateway adds one.
# Development needs no setting here: the prefix defaults to /api in a dev build
# (the Vite proxy strips it) and to empty in a production build.
VITE_API_PATH_PREFIX=

# Google Maps JavaScript API key for the hotspots map on the dashboard.
#
# Create one in the Google Cloud console (APIs & Services -> Credentials) and
# RESTRICT it before use:
#   * Application restriction -> HTTP referrers -> http://localhost:5174/*
#     and whatever origin the built dashboard is served from
#   * API restriction -> Maps JavaScript API
#
# The key is loaded by the browser, so it is never a server secret: a referrer
# restriction is what keeps it usable only from this app. Never commit a filled
# in .env, and never put the key in any TypeScript or Python file.
VITE_GOOGLE_MAPS_API_KEY=
