# CivicAI Backend Environment Variables
# Copy this file to .env and fill in your values.
#
# `.env` is git-ignored. Never commit a filled-in copy, and never paste a real
# secret into this file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Declares where the service is running. Set to "production" in a deployment.
#
# With CIVICAI_ENV=production the service REFUSES to start if DATABASE_URL is
# missing or points at a SQLite file. Without it, a missing DATABASE_URL
# silently falls back to a throwaway local SQLite file, where writes appear to
# succeed and are then lost -- so production deployments must set it.
#
# Leave unset (or "development") for local work.
# CIVICAI_ENV=development

# ---------------------------------------------------------------------------
# Database  (REQUIRED in production)
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Required when CIVICAI_ENV=production.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Keep the password in the deployment platform's secret store and inject it at
# runtime; do not commit it.
#
# Local development example (dev-only credentials, never use in production):
#   DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/civicai
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication  (REQUIRED -- the service will not start without it)
# ---------------------------------------------------------------------------
# Signing key for JWTs. The service refuses to start if this is missing or left
# as the placeholder below, because that value is published in this repository.
#
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API. Only needed
# when the frontends are served from a different origin than the API; when they
# are same-origin (or behind one reverse proxy), the default dev origins are
# fine and requests never become cross-origin.
#
# Never use "*": a wildcard is rejected alongside credentials, and would mean
# any site could call this API.
#
# Example for a split deployment:
#   CORS_ORIGINS=https://citizen.civicai.example,https://gov.civicai.example
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# mock | gemini
# Default: mock
# - mock: Keyword-based analysis, works offline, no API keys required
# - gemini: Google Gemini AI (requires valid GEMINI_API_KEY and accessible project)
AI_PROVIDER=mock

# Gemini API Key (only needed when AI_PROVIDER=gemini)
# Get your key from https://aistudio.google.com/app/apikey
# Note: The Google AI project must have Generative Language API access enabled.
# If you get 403 PERMISSION_DENIED, the project may not have access granted.
# Current known state: May return 403 for some projects.
# GEMINI_API_KEY=your_api_key_here

# Optional: Gemini model to use (default: gemini-3-flash-preview)
# Other options: gemini-1.5-flash, gemini-1.5-pro, gemini-1.0-pro
# GEMINI_MODEL=gemini-3-flash-preview

# ---------------------------------------------------------------------------
# Optional: BigQuery analytics sync (off by default)
# ---------------------------------------------------------------------------
# ENABLE_BIGQUERY_SYNC=false
# BIGQUERY_PROJECT=your-gcp-project-id
# BIGQUERY_DATASET=your_dataset_id