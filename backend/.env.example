# CivicAI Backend Environment Variables
# Copy this file to .env and fill in your values

# AI Provider: mock | gemini
# Default: mock
# - mock: Keyword-based analysis, works offline, no API keys required
# - gemini: Google Gemini AI (requires valid GEMINI_API_KEY and accessible project)
AI_PROVIDER=mock

# Gemini API Key (only needed when AI_PROVIDER=gemini)
# Get your key from https://aistudio.google.com/app/apikey
# Note: The Google AI project must have Generative Language API access enabled.
# If you get 403 PERMISSION_DENIED, the project may not have access granted.
# Current known state: May return 403 for some projects.
# GEMINI_API_KEY=your_api_key_here

# Optional: Gemini model to use (default: gemini-3-flash-preview)
# Other options: gemini-1.5-flash, gemini-1.5-pro, gemini-1.0-pro
# GEMINI_MODEL=gemini-3-flash-preview

# JWT Secret Key for authentication tokens
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production